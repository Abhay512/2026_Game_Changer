# Where the raw CSV tree lives ({year}/{SYMBOL}/equity|futures|options/...)
RAW_DATA_DIR=./h2_2025/h2_2025
# Where ingest writes Parquet + catalog (mount as a volume on a server)
STORE_DIR=./store
# Interface and port the app listens on (use HOST=0.0.0.0 on a server / in Docker)
HOST=127.0.0.1
PORT=8000
# Server processes. 1 is plenty for one user; on a server with several users use 2-4
# (each process keeps its own caches, so memory grows with this number)
WORKERS=1
# Optional: set to require HTTP basic auth (any username, this password). /api/health stays open.
APP_PASSWORD=
# Parallel ingest workers (0 = auto, ~300-600 MB RAM each)
INGEST_WORKERS=0
# Optional: download the store from a GitHub release on start (instead of running ingest on the server)
DATA_RELEASE=
GITHUB_REPO=
# read-only token for a private repo (fine-grained, Contents: read)
GITHUB_TOKEN=
# In-memory caches. Defaults suit a machine with 2+ GB free; on a 1 GB server use e.g. 12 / 6 / 256.
CACHE_SYMBOLS=48
CACHE_EXPIRIES=16
CACHE_RESPONSES=512
